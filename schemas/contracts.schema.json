{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sensei:manager:contracts:1.0",
  "$comment": "Structural schemas. The runtime validator also enforces graph, approval digest, evidence integrity, candidate and readiness invariants.",
  "oneOf": [
    {
      "$ref": "#/$defs/plan"
    },
    {
      "$ref": "#/$defs/receipt"
    },
    {
      "$ref": "#/$defs/candidate"
    }
  ],
  "$defs": {
    "candidate": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "sensei.candidate/1.0"
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "base_commit": {
          "type": "string",
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "commit": {
          "type": "string",
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "tree": {
          "type": "string",
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "diff_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "dirty": {
          "type": "boolean"
        },
        "untracked_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "fixture_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "environment_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "schema",
        "repository",
        "base_commit",
        "commit",
        "tree",
        "diff_sha256",
        "dirty",
        "untracked_sha256",
        "fixture_sha256",
        "environment_sha256"
      ],
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "producer": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "path",
        "sha256",
        "bytes",
        "media_type",
        "producer",
        "created_at"
      ],
      "additionalProperties": false
    },
    "approval": {
      "type": "object",
      "properties": {
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "authority_ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "digest",
        "authority_ref"
      ],
      "additionalProperties": false
    },
    "behavior": {
      "type": "object",
      "properties": {
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "acceptance": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "non_goals": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "decision_owner": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "goal",
        "examples",
        "acceptance",
        "non_goals",
        "decision_owner"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "base_commit": {
          "type": "string",
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
        }
      },
      "required": [
        "repository",
        "base_commit"
      ],
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "max_handoffs": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "repair_limit": {
          "enum": [
            null,
            0
          ]
        }
      },
      "required": [
        "max_handoffs",
        "repair_limit"
      ],
      "additionalProperties": false
    },
    "route": {
      "type": "object",
      "properties": {
        "profile_ref": {
          "type": "string",
          "minLength": 1
        },
        "available": {
          "type": "boolean"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "profile_ref",
        "available",
        "capabilities",
        "reason"
      ],
      "additionalProperties": false
    },
    "task": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "outcome": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "manager",
            "code",
            "review",
            "qa"
          ]
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "acceptance": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "permitted_effects": {
          "type": "array",
          "items": {
            "enum": [
              "read_source",
              "workspace_write",
              "local_test"
            ]
          },
          "minItems": 1
        },
        "write_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "max_attempts": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "required_capabilities": {
          "type": "array",
          "items": {
            "enum": [
              "qualify_route",
              "propose_patch",
              "review_candidate",
              "verify_candidate",
              "prove_continuity"
            ]
          },
          "minItems": 1
        },
        "required_evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "mandatory": {
          "type": "boolean"
        }
      },
      "required": [
        "task_id",
        "outcome",
        "role",
        "dependencies",
        "inputs",
        "acceptance",
        "permitted_effects",
        "write_paths",
        "max_attempts",
        "required_capabilities",
        "required_evidence",
        "mandatory"
      ],
      "additionalProperties": false
    },
    "plan": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "sensei.manager.plan/1.0"
        },
        "workflow_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "behavior": {
          "$ref": "#/$defs/behavior"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "limits": {
          "$ref": "#/$defs/limits"
        },
        "routes": {
          "type": "object",
          "properties": {
            "manager": {
              "$ref": "#/$defs/route"
            },
            "code": {
              "$ref": "#/$defs/route"
            },
            "review": {
              "$ref": "#/$defs/route"
            },
            "qa": {
              "$ref": "#/$defs/route"
            }
          },
          "required": [
            "manager",
            "code",
            "review",
            "qa"
          ],
          "additionalProperties": false
        },
        "approvals": {
          "type": "object",
          "properties": {
            "behavior": {
              "anyOf": [
                {
                  "$ref": "#/$defs/approval"
                },
                {
                  "type": "null"
                }
              ]
            },
            "implementation": {
              "anyOf": [
                {
                  "$ref": "#/$defs/approval"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "behavior",
            "implementation"
          ],
          "additionalProperties": false
        },
        "tasks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/task"
          },
          "minItems": 1,
          "maxItems": 32
        }
      },
      "required": [
        "schema",
        "workflow_id",
        "behavior",
        "source",
        "limits",
        "routes",
        "approvals",
        "tasks"
      ],
      "additionalProperties": false
    },
    "receipt": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "sensei.manager.receipt/1.0"
        },
        "workflow_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "task_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "handoff_operation_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "component_run_ref": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": [
            "passed",
            "failed",
            "blocked",
            "needs_decision",
            "cancelled"
          ]
        },
        "candidate": {
          "anyOf": [
            {
              "$ref": "#/$defs/candidate"
            },
            {
              "type": "null"
            }
          ]
        },
        "effects": {
          "enum": [
            "confirmed",
            "not_sent",
            "unknown"
          ]
        },
        "obligations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "criteria": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "passed",
              "failed",
              "pass",
              "fail",
              "blocked",
              "skipped",
              "flaky",
              "not_run"
            ]
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact"
          },
          "minItems": 0,
          "maxItems": 16
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "schema",
        "workflow_id",
        "task_id",
        "handoff_operation_id",
        "component_run_ref",
        "state",
        "candidate",
        "effects",
        "obligations",
        "criteria",
        "artifacts",
        "reason"
      ],
      "additionalProperties": false
    }
  }
}
